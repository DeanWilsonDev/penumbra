Point :: import Point;
Rect :: import Rect;
Color :: import Color;
Transform :: import Transform;

LineJoin :: enum {
    Miter,
    Bevel,
    Round
}

LineCap :: enum {
    Butt,
    Square,
    Round
}

IRenderer :: interface {
    FillRect~ (rect: Rect, color: Color) -> void : 0;
    StrokeRect~ (rect: Rect, color: Color, thicknessLogical: f32) -> void : 0;
    FillRoundedRect~ (rect: Rect, color: Color, cornerRadiusLogical: f32) -> void : 0;
    StrokeRoundedRect~ (rect: Rect, color: Color, thicknessLogical: f32, cornerRadiusLogical: f32) -> void : 0;
    FillGradientRect~ (rect: Rect, topColor: Color, bottomColor: Color, cornerRadiusLogical: f32) -> void : 0;
    DrawDropShadow~ (rect: Rect, color: Color, blurRadiusLogical: f32, cornerRadiusLogical: f32) -> void : 0;
    DrawLine~ (from: Point, to: Point, color: Color, thicknessLogical: f32) -> void : 0;
    DrawText~ (text: string, origin: Point, sizeLogical: f32, color: Color) -> void : 0;
    PushClipRect~ (rect: Rect) -> void : 0;
    PushClipRectUnbounded~ (rect: Rect?) -> void : 0;
    PopClipRect~ () -> void : 0;
    PushTransform~ (subjectRectLogical: Rect, transform: Transform, opacity: f32) -> void : 0;
    PopTransform~ () -> void : 0;
    DrawFilledCircle~ (centre: Point, radiusLogical: f32, color: Color) -> void : 0;
    DrawArc~ (centre: Point, innerRadiusLogical: f32, outerRadiusLogical: f32, startDegrees: f32, sweepDegrees: f32, color: Color) -> void : 0;
    DrawPolyline~ (points: Array<Point>, color: Color, thicknessLogical: f32, join: LineJoin, cap: LineCap) -> void : 0;
    DrawFilledPolygon~ (points: Array<Point>, color: Color) -> void : 0;
    GetFrameIndex : () -> u64 : 0;
    GetFrameDeltaSeconds : () -> f32 : 0;
    GetDpiScaleFactor : () -> f32 : 0;
    CreateTargetTexture~ (widthPhysical: i32, heightPhysical: i32) -> u64 : 0;
    DestroyTexture~ (texture: u64) -> void : 0;
    BeginTextureTarget~ (texture: u64, clearColor: Color) -> void : 0;
    EndTextureTarget~ () -> void : 0;
    DrawTexture~ (texture: u64, destinationLogical: Rect) -> void : 0;
}

RoundedRects :: namespace {
    Fill :: (renderer: IRenderer~*, rect: Rect, color: Color, cornerRadiusLogical: f32) -> void {
        if cornerRadiusLogical > 0.0f {
            renderer->FillRoundedRect(rect, color, cornerRadiusLogical);
            return;
        }
        renderer->FillRect(rect, color);
    }

    Stroke :: (renderer: IRenderer~*, rect: Rect, color: Color, thicknessLogical: f32, cornerRadiusLogical: f32) -> void {
        if cornerRadiusLogical > 0.0f {
            renderer->StrokeRoundedRect(rect, color, thicknessLogical, cornerRadiusLogical);
            return;
        }
        renderer->StrokeRect(rect, color, thicknessLogical);
    }
}

IImageBackend :: interface {
    LoadTexture~ (filePath: string) -> u64 : 0;
    TextureSizeLogical : (texture: u64) -> Point : 0;
    ReleaseTexture~ (texture: u64) -> void : 0;
}

IFontBackend :: interface {
    MeasureText : (text: string, sizeLogical: f32) -> Point : 0;
    MeasureAscent : (sizeLogical: f32) -> f32 : 0;
}

IIconBackend :: interface {
    DrawIcon~ (renderer: IRenderer~*, iconName: string, boundsLogical: Rect, iconColor: Color) -> void : 0;
}
