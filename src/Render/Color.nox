Color :: struct {
    red~ u8 = 0;
    green~ u8 = 0;
    blue~ u8 = 0;
    alpha~ u8 = 0;

    IsVisible :: () -> bool {
        return alpha > 0;
    }
}

Colors :: namespace {
    SetOr :: (preferred: Color, fallback: Color) -> Color {
        if preferred.IsVisible() {
            return preferred;
        }
        return fallback;
    }
}
