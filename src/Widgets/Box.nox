Point :: import Point;
Transform :: import Transform;
Transforms :: import Transforms;
Rect :: import Rect;
Numbers :: import Numbers;
Color :: import Color;
Colors :: import Colors;
IRenderer :: import IRenderer;
EdgeInsets :: import EdgeInsets;
LayoutMode :: import LayoutMode;
CrossAlign :: import CrossAlign;
Justify :: import Justify;
BoxStyle :: import BoxStyle;
Length :: import Length;
WidgetBase :: import WidgetBase;
InteractionState :: import InteractionState;
InputState :: import InputState;
MouseButton :: import MouseButton;
Placement :: import Placement;
LayoutContext :: import LayoutContext;
Positioning :: import Positioning;
StackingTracker :: import StackingTracker;
StackingContext :: import StackingContext;
StackingPass :: import StackingPass;
Stacking :: import Stacking;
RoundedRects :: import RoundedRects;
TransitionSpec :: import TransitionSpec;
Easing :: import Easing;
EasedTrack :: import EasedTrack;
Anim :: import Anim;
Tween :: import Tween;
TextSelection :: import TextSelection;

BoxTransitionState :: struct {
    width~ EasedTrack<Length> = EasedTrack<Length> { from: Length { }, target: Length { } };
    height~ EasedTrack<Length> = EasedTrack<Length> { from: Length { }, target: Length { } };
    flexGrow~ EasedTrack<f32> = EasedTrack<f32> { from: 0.0f, target: 0.0f };
    background~ EasedTrack<Color> = EasedTrack<Color> { from: Color { }, target: Color { } };
    opacity~ EasedTrack<f32> = EasedTrack<f32> { from: 0.0f, target: 0.0f };
    lastWidthLogical~ f32 = -1.0f;
    lastHeightLogical~ f32 = -1.0f;
    entered~ bool = false;
    lastAdvancedFrame~ u64 = 0;
}

MeasureMemo :: struct {
    passId~ u64 = 0;
    available~ Point = Point { };
    desired~ Point = Point { };
}

CrossPlacement :: struct {
    position~ f32 = 0.0f;
    extent~ f32 = 0.0f;
}

Box :: class : WidgetBase {
public:
    startingStyle~ BoxStyle? = null;
    style~ BoxStyle = BoxStyle { };
    children~ Array<WidgetBase*!>! = [];
    layout~ LayoutMode = LayoutMode:::None;
    childGap~ f32 = 0.0f;
    crossAlignment~ CrossAlign = CrossAlign:::Start;
    justifyContentMode~ Justify = Justify:::Start;
    leadingExtentLogical~ f32 = -1.0f;

    !Box~: () {
        this->children.freeAll();
        delete this->selection;
    }

    EnableTextSelection~: () -> TextSelection~* {
        if this->selection == null {
            created: TextSelection*! = new TextSelection();
            this->selection = created!;
        }
        if active ~= this->selection {
            return active;
        }
        return this->EnableTextSelection();
    }

    GetTextSelection~: () -> TextSelection~*? {
        if active ~= this->selection {
            return active;
        }
        return null;
    }

    AddChild~: (child: WidgetBase*!) -> WidgetBase~* {
        this->children.push(child!);
        return this->children[this->children.length() - 1];
    }

    InsertChildAt~: (index: usize, child: WidgetBase*!) -> WidgetBase~* {
        this->children.insert(index, child!);
        return this->children[index];
    }

    RemoveChildAt~: (index: usize) -> void {
        removed: WidgetBase*! = this->children.remove(index);
        delete removed;
    }

    GetMarginLogical :: () -> EdgeInsets override {
        return this->style.margin;
    }

    GetPlacement :: () -> Placement override {
        return this->style.PlacementOf();
    }

    GetFlexGrow :: () -> f32 override {
        if !this->easing || !this->eased.flexGrow.known || this->style.flexGrowTransition == null {
            return this->style.flexGrow;
        }
        track: EasedTrack<f32> = this->eased.flexGrow;
        return BoxTransitions:::Lerp(track.from, track.target, track.Progress());
    }

    OnShown~: () -> void override {
        this->eased.entered = false;
    }

    GetChildCount :: () -> usize override {
        return this->children.length();
    }

    GetChildAt :: (index: usize) -> WidgetBase*? override {
        return this->children[index];
    }

    GetMutableChildAt~: (index: usize) -> WidgetBase~*? override {
        return this->children[index];
    }

    Measure~: (availableSizeLogical: Point, layout: LayoutContext~*) -> Point override {
        pass: u64 = layout->passId;
        if pass != 0 {
            for memo in this->measureMemos {
                if memo.passId == pass && memo.available.x == availableSizeLogical.x && memo.available.y == availableSizeLogical.y {
                    return memo.desired;
                }
            }
        }
        desired: Point = this->MeasureUncached(availableSizeLogical, layout);
        if pass != 0 {
            this->measureMemos[this->nextMeasureMemo] = MeasureMemo { passId: pass, available: availableSizeLogical, desired: desired };
            this->nextMeasureMemo = (this->nextMeasureMemo + 1) % this->measureMemos.length();
        }
        return desired;
    }

    MeasureUncached~: (availableSizeLogical: Point, layout: LayoutContext~*) -> Point {
        this->SyncLayoutTransitions();
        frame: Point = this->FrameSize();
        effectiveAvailable: Point = this->ConstrainAvailable(availableSizeLogical, layout);
        contentAvailable: Point = Point {
            x: Numbers:::NonNegative(effectiveAvailable.x - frame.x),
            y: Numbers:::NonNegative(effectiveAvailable.y - frame.y)
        };
        contentDesired~ Point = Point { };
        if this->layout == LayoutMode:::None {
            contentDesired = this->MeasureContent(contentAvailable, layout);
        }
        else if this->layout == LayoutMode:::FixedLeadingStack {
            this->MeasureFixedLeading(contentAvailable, layout);
            contentDesired = contentAvailable;
        }
        else {
            contentDesired = this->MeasureStack(contentAvailable, layout);
        }
        return this->ConstrainDesired(Point { x: contentDesired.x + frame.x, y: contentDesired.y + frame.y }, availableSizeLogical, layout);
    }

    Arrange~: (finalRectLogical: Rect, layout: LayoutContext~*) -> void override {
        this->arrangedRect = finalRectLogical;
        pushedBlocks: usize = layout->EnterBlock(this->style.PlacementOf(), this->PaddingRectFrom(finalRectLogical));
        content: Rect = this->ContentRectFrom(finalRectLogical);
        if this->layout == LayoutMode:::None {
            for child in this->children {
                if Positioning:::IsOutOfFlow(child) {
                    this->PlaceOutOfFlow(child, Point { x: content.x, y: content.y }, layout);
                }
            }
        }
        else if this->layout == LayoutMode:::FixedLeadingStack {
            this->ArrangeFixedLeading(content, layout);
        }
        else {
            this->ArrangeStack(content, layout);
        }
        layout->LeaveBlocks(pushedBlocks);
    }

    UpdateInteractionState~: (input: InputState, stacking: StackingTracker~*) -> bool override {
        if stacking->IsLayeredOut(this) {
            return false;
        }
        untransformed~ InputState = input;
        if !this->style.transform.IsIdentity() {
            pivot: Point = Point {
                x: this->arrangedRect.x + this->arrangedRect.width * 0.5f,
                y: this->arrangedRect.y + this->arrangedRect.height * 0.5f
            };
            untransformed.mousePosition = Transforms:::InversePoint(input.mousePosition, pivot, this->style.transform);
        }
        effective~ InputState = Stacking:::ForPointerEvents(this->style.pointerEventsMode, untransformed);
        taken~ TextSelection*!? = this->selection!;
        this->selection = null;
        if active ~= taken {
            active->Update(this, this->arrangedRect, effective);
        }
        this->selection = taken!;
        outermostKeys: bool = stacking->keys->Begin(this, effective);
        defer stacking->keys->End(outermostKeys);
        context: StackingContext*! = new StackingContext(this, StackingPass:::Input, stacking);
        defer delete context;
        childConsumed~ bool = context->DispatchAbove(effective);
        index~ usize = this->children.length();
        while index > 0 {
            index = index - 1;
            child: WidgetBase~* = this->children[index];
            if !child->GetIsVisible() || stacking->IsLayeredOut(child) {
                continue;
            }
            childInput~ InputState = effective;
            if childConsumed {
                childInput = effective.Occluded();
            }
            if stacking->DispatchToChild(child, childInput) {
                childConsumed = true;
            }
        }
        if context->DispatchBelow(effective, childConsumed) {
            childConsumed = true;
        }
        if effective.pointerOccluded && stacking->IsOnPointerPath(this) {
            effective.pointerOccluded = false;
            childConsumed = true;
        }

        if !this->isEnabled {
            this->currentState = InteractionState:::Disabled;
            this->pressedInside = false;
            if this->wasHovered {
                if handler := this->onUnhovered {
                    handler();
                }
            }
            this->wasHovered = false;
            return childConsumed;
        }

        if !this->HasCallbacks() && !this->style.HasInteractionColors() {
            this->currentState = InteractionState:::Default;
            this->pressedInside = false;
            this->wasHovered = false;
            return childConsumed;
        }

        left: usize = MouseButton:::Left();
        hovered: bool = effective.IsPointerOver(this->arrangedRect);
        pressed: bool = effective.mouseButtonPressedThisFrame[left];
        down: bool = effective.mouseButtonDown[left];
        released: bool = effective.mouseButtonReleasedThisFrame[left];

        if hovered {
            if handler := this->onHovered {
                handler();
            }
        }
        if !hovered && this->wasHovered {
            if handler := this->onUnhovered {
                handler();
            }
        }
        this->wasHovered = hovered;
        if pressed && hovered && !childConsumed {
            this->pressedInside = true;
            if handler := this->onPressed {
                handler();
            }
        }
        if released {
            if this->pressedInside {
                if handler := this->onReleased {
                    handler();
                }
            }
            this->pressedInside = false;
        }

        if this->pressedInside && down && hovered {
            this->currentState = InteractionState:::Pressed;
        }
        else if hovered {
            this->currentState = InteractionState:::Hovered;
        }
        else {
            this->currentState = InteractionState:::Default;
        }
        return childConsumed || hovered || (this->pressedInside && down);
    }

    virtual BackgroundForState :: () -> Color {
        return when this->currentState {
            InteractionState:::Hovered -> Colors:::SetOr(this->style.colorBackgroundHovered, this->style.colorBackground),
            InteractionState:::Pressed -> Colors:::SetOr(this->style.colorBackgroundPressed, this->style.colorBackground),
            InteractionState:::Disabled -> Colors:::SetOr(this->style.colorBackgroundDisabled, this->style.colorBackground),
            InteractionState:::Default -> this->style.colorBackground
        };
    }

    GradientTopForState :: () -> Color {
        return when this->currentState {
            InteractionState:::Hovered -> Colors:::SetOr(this->style.gradientTopHovered, this->style.gradientTop),
            InteractionState:::Pressed -> Colors:::SetOr(this->style.gradientTopPressed, this->style.gradientTop),
            InteractionState:::Disabled -> this->style.gradientTop,
            InteractionState:::Default -> this->style.gradientTop
        };
    }

    GradientBottomForState :: () -> Color {
        return when this->currentState {
            InteractionState:::Hovered -> Colors:::SetOr(this->style.gradientBottomHovered, this->style.gradientBottom),
            InteractionState:::Pressed -> Colors:::SetOr(this->style.gradientBottomPressed, this->style.gradientBottom),
            InteractionState:::Disabled -> this->style.gradientBottom,
            InteractionState:::Default -> this->style.gradientBottom
        };
    }

    BorderForState :: () -> Color {
        return when this->currentState {
            InteractionState:::Hovered -> Colors:::SetOr(this->style.colorBorderHovered, this->style.colorBorder),
            InteractionState:::Pressed -> Colors:::SetOr(this->style.colorBorderPressed, this->style.colorBorder),
            InteractionState:::Disabled -> Colors:::SetOr(this->style.colorBorderDisabled, this->style.colorBorder),
            InteractionState:::Default -> this->style.colorBorder
        };
    }

    Draw~: (renderer: IRenderer~*, stacking: StackingTracker~*) -> void override {
        if stacking->IsLayeredOut(this) {
            return;
        }
        if !this->isVisible {
            return;
        }
        this->AdvanceTransitions(renderer);
        opacity: f32 = this->DisplayedOpacity();
        if opacity <= 0.0f {
            return;
        }
        transformed: bool = !this->style.transform.IsIdentity() || opacity < 1.0f;
        if transformed {
            renderer->PushTransform(this->arrangedRect, this->style.transform, opacity);
        }
        context: StackingContext*! = new StackingContext(this, StackingPass:::Paint, stacking);
        defer delete context;
        radius: f32 = this->style.borderRadius;
        if this->style.shadowBlurRadiusLogical > 0.0f {
            renderer->DrawDropShadow(this->arrangedRect, this->style.shadowColor, this->style.shadowBlurRadiusLogical, radius);
        }
        background: Color = this->DisplayedBackground();
        gradientTop: Color = this->GradientTopForState();
        if gradientTop.IsVisible() {
            renderer->FillGradientRect(this->arrangedRect, gradientTop, this->GradientBottomForState(), radius);
        }
        else if background.IsVisible() {
            RoundedRects:::Fill(renderer, this->arrangedRect, background, radius);
        }
        border: Color = this->BorderForState();
        if this->style.borderWidth > 0.0f && border.IsVisible() {
            RoundedRects:::Stroke(renderer, this->arrangedRect, border, this->style.borderWidth, radius);
        }
        this->DrawContent(renderer, this->ContentRectFrom(this->arrangedRect));
        if active := this->selection {
            active->DrawGaps(renderer);
        }
        context->PaintBelow(renderer);
        for child in this->children {
            if child->GetIsVisible() && !stacking->IsLayeredOut(child) {
                child->Draw(renderer, stacking);
            }
        }
        context->PaintAbove(renderer);
        if transformed {
            renderer->PopTransform();
        }
    }

    PaintsAsGroup :: () -> bool override {
        return !this->style.transform.IsIdentity() || this->DisplayedOpacity() < 1.0f;
    }

protected:
    selection~ TextSelection*!? = null;
    easing~ bool = false;
    eased~ BoxTransitionState = BoxTransitionState { };

    SyncLayoutTransitions~: () -> void {
        if !this->style.HasTransitions() {
            this->easing = false;
            this->eased = BoxTransitionState { };
            return;
        }
        this->easing = true;
        widthSpec: TransitionSpec? = this->style.widthTransition;
        heightSpec: TransitionSpec? = this->style.heightTransition;
        growSpec: TransitionSpec? = this->style.flexGrowTransition;
        widthTarget: Length = this->style.width;
        heightTarget: Length = this->style.height;

        if !this->eased.entered {
            this->eased.entered = true;
            this->eased.lastWidthLogical = -1.0f;
            this->eased.lastHeightLogical = -1.0f;
            starting~ BoxStyle = this->style;
            hasStart~ bool = false;
            if start := this->startingStyle {
                starting = start;
                hasStart = true;
            }
            backgroundSpec: TransitionSpec? = this->style.backgroundColorTransition;
            opacitySpec: TransitionSpec? = this->style.opacityTransition;
            this->eased.width.Start(starting.width, widthTarget, BoxTransitions:::Duration(widthSpec), BoxTransitions:::Curve(widthSpec), hasStart && starting.width.IsSet() && widthTarget.IsSet());
            this->eased.height.Start(starting.height, heightTarget, BoxTransitions:::Duration(heightSpec), BoxTransitions:::Curve(heightSpec), hasStart && starting.height.IsSet() && heightTarget.IsSet());
            this->eased.flexGrow.Start(starting.flexGrow, this->style.flexGrow, BoxTransitions:::Duration(growSpec), BoxTransitions:::Curve(growSpec), hasStart);
            this->eased.background.Start(starting.colorBackground, this->BackgroundForState(), BoxTransitions:::Duration(backgroundSpec), BoxTransitions:::Curve(backgroundSpec), hasStart);
            this->eased.opacity.Start(starting.opacity, this->style.opacity, BoxTransitions:::Duration(opacitySpec), BoxTransitions:::Curve(opacitySpec), hasStart);
            return;
        }

        widthNow~ Length = Length { };
        if this->eased.lastWidthLogical >= 0.0f {
            widthNow = Length:::Logical(this->eased.lastWidthLogical);
        }
        heightNow~ Length = Length { };
        if this->eased.lastHeightLogical >= 0.0f {
            heightNow = Length:::Logical(this->eased.lastHeightLogical);
        }
        if !this->eased.width.known || !BoxTransitions:::SameLength(this->eased.width.target, widthTarget) {
            canEase: bool = this->eased.width.known && widthTarget.IsSet() && widthNow.IsSet();
            this->eased.width.Start(widthNow, widthTarget, BoxTransitions:::Duration(widthSpec), BoxTransitions:::Curve(widthSpec), canEase);
        }
        if !this->eased.height.known || !BoxTransitions:::SameLength(this->eased.height.target, heightTarget) {
            canEase: bool = this->eased.height.known && heightTarget.IsSet() && heightNow.IsSet();
            this->eased.height.Start(heightNow, heightTarget, BoxTransitions:::Duration(heightSpec), BoxTransitions:::Curve(heightSpec), canEase);
        }
        grow: EasedTrack<f32> = this->eased.flexGrow;
        if !grow.known || grow.target != this->style.flexGrow {
            growNow: f32 = BoxTransitions:::Lerp(grow.from, grow.target, grow.Progress());
            this->eased.flexGrow.Start(growNow, this->style.flexGrow, BoxTransitions:::Duration(growSpec), BoxTransitions:::Curve(growSpec), grow.known);
        }
    }

    AdvanceTransitions~: (renderer: IRenderer~*) -> void {
        if !this->easing {
            return;
        }
        frame: u64 = renderer->GetFrameIndex();
        if frame == 0 {
            this->eased.width.timeline = Tween { };
            this->eased.height.timeline = Tween { };
            this->eased.flexGrow.timeline = Tween { };
            this->eased.background.timeline = Tween { };
            this->eased.opacity.timeline = Tween { };
        }
        else if frame != this->eased.lastAdvancedFrame {
            delta: f32 = renderer->GetFrameDeltaSeconds();
            this->eased.width.timeline.Update(delta);
            this->eased.height.timeline.Update(delta);
            this->eased.flexGrow.timeline.Update(delta);
            this->eased.background.timeline.Update(delta);
            this->eased.opacity.timeline.Update(delta);
        }
        this->eased.lastAdvancedFrame = frame;

        backgroundSpec: TransitionSpec? = this->style.backgroundColorTransition;
        backgroundTarget: Color = this->BackgroundForState();
        if !this->eased.background.known || !BoxTransitions:::SameColor(this->eased.background.target, backgroundTarget) {
            backgroundNow: Color = this->DisplayedBackground();
            this->eased.background.Start(backgroundNow, backgroundTarget, BoxTransitions:::Duration(backgroundSpec), BoxTransitions:::Curve(backgroundSpec), this->eased.background.known);
        }
        opacitySpec: TransitionSpec? = this->style.opacityTransition;
        if !this->eased.opacity.known || this->eased.opacity.target != this->style.opacity {
            opacityNow: f32 = this->DisplayedOpacity();
            this->eased.opacity.Start(opacityNow, this->style.opacity, BoxTransitions:::Duration(opacitySpec), BoxTransitions:::Curve(opacitySpec), this->eased.opacity.known);
        }
    }

    DisplayedBackground :: () -> Color {
        if !this->easing || !this->eased.background.known || this->style.backgroundColorTransition == null {
            return this->BackgroundForState();
        }
        track: EasedTrack<Color> = this->eased.background;
        return Anim:::LerpColor(track.from, track.target, track.Progress());
    }

    DisplayedOpacity :: () -> f32 {
        if !this->easing || !this->eased.opacity.known || this->style.opacityTransition == null {
            return this->style.opacity;
        }
        track: EasedTrack<f32> = this->eased.opacity;
        return BoxTransitions:::Lerp(track.from, track.target, track.Progress());
    }

    PlaceCross :: (contentStart: f32, contentExtent: f32, childExtent: f32, marginLead: f32, marginTrail: f32) -> CrossPlacement {
        available: f32 = Numbers:::NonNegative(contentExtent - marginLead - marginTrail);
        return when this->crossAlignment {
            CrossAlign:::Start -> CrossPlacement { position: contentStart + marginLead, extent: childExtent },
            CrossAlign:::Center -> CrossPlacement { position: contentStart + marginLead + (available - childExtent) / 2.0f, extent: childExtent },
            CrossAlign:::End -> CrossPlacement { position: contentStart + contentExtent - marginTrail - childExtent, extent: childExtent },
            CrossAlign:::Stretch -> CrossPlacement { position: contentStart + marginLead, extent: available }
        };
    }

    virtual MeasureContent~: (availableContentSize: Point, layout: LayoutContext~*) -> Point {
        return Point { };
    }

    virtual DrawContent~: (renderer: IRenderer~*, contentRect: Rect) -> void {
    }

    FrameSize :: () -> Point {
        return Point {
            x: this->style.padding.Horizontal() + 2.0f * this->style.borderWidth,
            y: this->style.padding.Vertical() + 2.0f * this->style.borderWidth
        };
    }

    PaddingRectFrom :: (outerRect: Rect) -> Rect {
        border: f32 = this->style.borderWidth;
        return Rect {
            x: outerRect.x + border,
            y: outerRect.y + border,
            width: Numbers:::NonNegative(outerRect.width - 2.0f * border),
            height: Numbers:::NonNegative(outerRect.height - 2.0f * border)
        };
    }

    ContentRectFrom :: (outerRect: Rect) -> Rect {
        border: f32 = this->style.borderWidth;
        return Rect {
            x: outerRect.x + border + this->style.padding.left,
            y: outerRect.y + border + this->style.padding.top,
            width: Numbers:::NonNegative(outerRect.width - 2.0f * border - this->style.padding.Horizontal()),
            height: Numbers:::NonNegative(outerRect.height - 2.0f * border - this->style.padding.Vertical())
        };
    }

    ConstrainAvailable~: (availableSizeLogical: Point, layout: LayoutContext~*) -> Point {
        return Point {
            x: this->ConstrainLength(true, availableSizeLogical.x, availableSizeLogical.x, layout),
            y: this->ConstrainLength(false, availableSizeLogical.y, availableSizeLogical.y, layout)
        };
    }

    ConstrainDesired~: (desiredSizeLogical: Point, availableSizeLogical: Point, layout: LayoutContext~*) -> Point {
        return Point {
            x: this->ConstrainLength(true, desiredSizeLogical.x, availableSizeLogical.x, layout),
            y: this->ConstrainLength(false, desiredSizeLogical.y, availableSizeLogical.y, layout)
        };
    }

private:
    measureMemos~ MeasureMemo[4] = [MeasureMemo { }, MeasureMemo { }, MeasureMemo { }, MeasureMemo { }];
    nextMeasureMemo~ usize = 0;
    pressedInside~ bool = false;
    wasHovered~ bool = false;

    ConstrainLength~: (isWidth: bool, value: f32, availableLogical: f32, layout: LayoutContext~*) -> f32 {
        size~ Length = this->style.height;
        track~ EasedTrack<Length> = this->eased.height;
        if isWidth {
            size = this->style.width;
            track = this->eased.width;
        }
        result~ f32 = value;
        if size.IsSet() {
            result = size.Resolve(availableLogical, layout->viewportLogical);
            if this->easing && track.known && BoxTransitions:::SameLength(track.target, size) && track.from.IsSet() {
                result = BoxTransitions:::Lerp(track.from.Resolve(availableLogical, layout->viewportLogical), result, track.Progress());
            }
        }
        if this->easing {
            laidOut~ f32 = -1.0f;
            if size.IsSet() {
                laidOut = result;
            }
            if isWidth {
                this->eased.lastWidthLogical = laidOut;
            }
            else {
                this->eased.lastHeightLogical = laidOut;
            }
        }
        if isWidth && this->style.maxWidth.IsSet() {
            result = Numbers:::Smaller(result, this->style.maxWidth.Resolve(availableLogical, layout->viewportLogical));
        }
        if isWidth && this->style.minWidth.IsSet() {
            result = Numbers:::Larger(result, this->style.minWidth.Resolve(availableLogical, layout->viewportLogical));
        }
        return result;
    }

    MainOf :: (vertical: bool, size: Point) -> f32 {
        if vertical {
            return size.y;
        }
        return size.x;
    }

    CrossOf :: (vertical: bool, size: Point) -> f32 {
        if vertical {
            return size.x;
        }
        return size.y;
    }

    MainMargin :: (vertical: bool, margin: EdgeInsets) -> f32 {
        if vertical {
            return margin.Vertical();
        }
        return margin.Horizontal();
    }

    CrossMargin :: (vertical: bool, margin: EdgeInsets) -> f32 {
        if vertical {
            return margin.Horizontal();
        }
        return margin.Vertical();
    }

    ChildAvailable :: (contentSize: Point, margin: EdgeInsets, vertical: bool, growExtent: f32) -> Point {
        available~ Point = Point {
            x: Numbers:::NonNegative(contentSize.x - margin.Horizontal()),
            y: Numbers:::NonNegative(contentSize.y - margin.Vertical())
        };
        if growExtent >= 0.0f {
            if vertical {
                available.y = growExtent;
            }
            else {
                available.x = growExtent;
            }
        }
        return available;
    }

    GrowExtents~: (vertical: bool, contentSize: Point, layout: LayoutContext~*) -> Array<f32>! {
        extents~ Array<f32>! = [];
        totalGrow~ f32 = 0.0f;
        for child in this->children {
            if Positioning:::InFlow(child) && child->GetFlexGrow() > 0.0f {
                totalGrow = totalGrow + child->GetFlexGrow();
            }
        }
        if totalGrow <= 0.0f {
            return extents!;
        }
        fixedMain~ f32 = 0.0f;
        visibleCount~ usize = 0;
        for child in this->children {
            if !Positioning:::InFlow(child) {
                continue;
            }
            visibleCount = visibleCount + 1;
            margin: EdgeInsets = child->GetMarginLogical();
            fixedMain = fixedMain + this->MainMargin(vertical, margin);
            if child->GetFlexGrow() > 0.0f {
                continue;
            }
            desired: Point = child->Measure(Point {
                x: Numbers:::NonNegative(contentSize.x - margin.Horizontal()),
                y: Numbers:::NonNegative(contentSize.y - margin.Vertical())
            }, layout);
            fixedMain = fixedMain + this->MainOf(vertical, desired);
        }
        gaps~ f32 = 0.0f;
        if visibleCount > 1 {
            gaps = f32(visibleCount - 1) * this->childGap;
        }
        remaining: f32 = Numbers:::NonNegative(this->MainOf(vertical, contentSize) - fixedMain - gaps);
        for child in this->children {
            if Positioning:::InFlow(child) && child->GetFlexGrow() > 0.0f {
                extents.push(remaining * child->GetFlexGrow() / totalGrow);
            }
            else {
                extents.push(-1.0f);
            }
        }
        return extents!;
    }

    GrowExtentAt :: (extents: Array<f32>, index: usize) -> f32 {
        if extents.length() == 0 {
            return -1.0f;
        }
        return extents[index];
    }

    MeasureFixedLeading~: (contentAvailable: Point, layout: LayoutContext~*) -> void {
        leadingExtent: f32 = Numbers:::NonNegative(this->leadingExtentLogical);
        fillHeight: f32 = Numbers:::NonNegative(contentAvailable.y - leadingExtent - this->childGap);
        leadingSeen~ bool = false;
        for child in this->children {
            if !Positioning:::InFlow(child) {
                continue;
            }
            margin: EdgeInsets = child->GetMarginLogical();
            slotHeight~ f32 = leadingExtent;
            if leadingSeen {
                slotHeight = fillHeight;
            }
            child->Measure(Point {
                x: Numbers:::NonNegative(contentAvailable.x - margin.Horizontal()),
                y: Numbers:::NonNegative(slotHeight - margin.Vertical())
            }, layout);
            leadingSeen = true;
        }
    }

    MeasureStack~: (contentAvailable: Point, layout: LayoutContext~*) -> Point {
        vertical: bool = this->layout == LayoutMode:::VerticalStack;
        mainTotal~ f32 = 0.0f;
        crossMax~ f32 = 0.0f;
        anyVisible~ bool = false;
        growExtents~ Array<f32>! = this->GrowExtents(vertical, contentAvailable, layout);
        defer delete growExtents;
        index~ usize = 0;
        for child in this->children {
            childIndex: usize = index;
            index = index + 1;
            if !Positioning:::InFlow(child) {
                continue;
            }
            margin: EdgeInsets = child->GetMarginLogical();
            desired: Point = child->Measure(this->ChildAvailable(contentAvailable, margin, vertical, this->GrowExtentAt(growExtents, childIndex)), layout);
            if anyVisible {
                mainTotal = mainTotal + this->childGap;
            }
            mainTotal = mainTotal + this->MainOf(vertical, desired) + this->MainMargin(vertical, margin);
            crossMax = Numbers:::Larger(crossMax, this->CrossOf(vertical, desired) + this->CrossMargin(vertical, margin));
            anyVisible = true;
        }
        if vertical {
            return Point { x: crossMax, y: mainTotal };
        }
        return Point { x: mainTotal, y: crossMax };
    }

    PlaceOutOfFlow :: (child: WidgetBase~*, at: Point, layout: LayoutContext~*) -> void {
        margin: EdgeInsets = child->GetMarginLogical();
        Positioning:::ArrangeOutOfFlow(child, Point { x: at.x + margin.left, y: at.y + margin.top }, layout);
    }

    ArrangeFixedLeading~: (content: Rect, layout: LayoutContext~*) -> void {
        leadingExtent: f32 = Numbers:::Smaller(Numbers:::NonNegative(this->leadingExtentLogical), content.height);
        fillTop: f32 = Numbers:::Smaller(content.height, leadingExtent + this->childGap);
        fillHeight: f32 = Numbers:::NonNegative(content.height - fillTop);
        leadingSeen~ bool = false;
        for child in this->children {
            if Positioning:::IsOutOfFlow(child) {
                staticTop~ f32 = content.y;
                if leadingSeen {
                    staticTop = content.y + fillTop;
                }
                this->PlaceOutOfFlow(child, Point { x: content.x, y: staticTop }, layout);
                continue;
            }
            if !child->GetIsVisible() {
                continue;
            }
            margin: EdgeInsets = child->GetMarginLogical();
            slotTop~ f32 = content.y;
            slotHeight~ f32 = leadingExtent;
            if leadingSeen {
                slotTop = content.y + fillTop;
                slotHeight = fillHeight;
            }
            desired: Point = child->Measure(Point {
                x: Numbers:::NonNegative(content.width - margin.Horizontal()),
                y: Numbers:::NonNegative(slotHeight - margin.Vertical())
            }, layout);
            cross: CrossPlacement = this->PlaceCross(content.x, content.width, desired.x, margin.left, margin.right);
            child->Arrange(Positioning:::OffsetInFlow(child, Rect {
                x: cross.position,
                y: slotTop + margin.top,
                width: cross.extent,
                height: Numbers:::NonNegative(slotHeight - margin.Vertical())
            }, content, null, layout), layout);
            leadingSeen = true;
        }
    }

    ArrangeStack~: (content: Rect, layout: LayoutContext~*) -> void {
        vertical: bool = this->layout == LayoutMode:::VerticalStack;
        contentSize: Point = Point { x: content.width, y: content.height };
        growExtents~ Array<f32>! = this->GrowExtents(vertical, contentSize, layout);
        defer delete growExtents;
        startOffset~ f32 = 0.0f;
        extraGapPerGap~ f32 = 0.0f;
        if this->justifyContentMode != Justify:::Start && growExtents.length() == 0 {
            totalChildrenMain~ f32 = 0.0f;
            visibleCount~ usize = 0;
            for child in this->children {
                if !Positioning:::InFlow(child) {
                    continue;
                }
                margin: EdgeInsets = child->GetMarginLogical();
                desired: Point = child->Measure(Point {
                    x: Numbers:::NonNegative(content.width - margin.Horizontal()),
                    y: Numbers:::NonNegative(content.height - margin.Vertical())
                }, layout);
                totalChildrenMain = totalChildrenMain + this->MainOf(vertical, desired) + this->MainMargin(vertical, margin);
                visibleCount = visibleCount + 1;
            }
            totalGaps~ f32 = 0.0f;
            if visibleCount > 1 {
                totalGaps = f32(visibleCount - 1) * this->childGap;
            }
            freeSpace: f32 = Numbers:::NonNegative(this->MainOf(vertical, contentSize) - totalChildrenMain - totalGaps);
            when this->justifyContentMode {
                Justify:::Start -> { },
                Justify:::Center -> {
                    startOffset = freeSpace / 2.0f;
                },
                Justify:::End -> {
                    startOffset = freeSpace;
                },
                Justify:::SpaceBetween -> {
                    if visibleCount > 1 {
                        extraGapPerGap = freeSpace / f32(visibleCount - 1);
                    }
                }
            }
        }
        cursor~ f32 = content.x + startOffset;
        if vertical {
            cursor = content.y + startOffset;
        }
        anyVisible~ bool = false;
        index~ usize = 0;
        for child in this->children {
            childIndex: usize = index;
            index = index + 1;
            if Positioning:::IsOutOfFlow(child) {
                next~ f32 = cursor;
                if anyVisible {
                    next = cursor + this->childGap + extraGapPerGap;
                }
                at~ Point = Point { x: next, y: content.y };
                if vertical {
                    at = Point { x: content.x, y: next };
                }
                this->PlaceOutOfFlow(child, at, layout);
                continue;
            }
            if !child->GetIsVisible() {
                continue;
            }
            margin: EdgeInsets = child->GetMarginLogical();
            growExtent: f32 = this->GrowExtentAt(growExtents, childIndex);
            desired: Point = child->Measure(this->ChildAvailable(contentSize, margin, vertical, growExtent), layout);
            if anyVisible {
                cursor = cursor + this->childGap + extraGapPerGap;
            }
            if vertical {
                cross: CrossPlacement = this->PlaceCross(content.x, content.width, desired.x, margin.left, margin.right);
                top: f32 = cursor + margin.top;
                height~ f32 = desired.y;
                if growExtent >= 0.0f {
                    height = growExtent;
                }
                child->Arrange(Positioning:::OffsetInFlow(child, Rect { x: cross.position, y: top, width: cross.extent, height: height }, content, null, layout), layout);
                cursor = top + height + margin.bottom;
            }
            else {
                cross: CrossPlacement = this->PlaceCross(content.y, content.height, desired.y, margin.top, margin.bottom);
                left: f32 = cursor + margin.left;
                width~ f32 = desired.x;
                if growExtent >= 0.0f {
                    width = growExtent;
                }
                child->Arrange(Positioning:::OffsetInFlow(child, Rect { x: left, y: cross.position, width: width, height: cross.extent }, content, null, layout), layout);
                cursor = left + width + margin.right;
            }
            anyVisible = true;
        }
    }
}

BoxTransitions :: namespace {
    Lerp :: (from: f32, to: f32, amount: f32) -> f32 {
        return from + (to - from) * amount;
    }

    Duration :: (spec: TransitionSpec?) -> f32 {
        if chosen := spec {
            return chosen.durationSeconds;
        }
        return 0.0f;
    }

    Curve :: (spec: TransitionSpec?) -> Easing {
        if chosen := spec {
            return chosen.curve;
        }
        return Easing:::Linear;
    }

    SameLength :: (first: Length, second: Length) -> bool {
        return first.value == second.value && first.unit == second.unit;
    }

    SameColor :: (first: Color, second: Color) -> bool {
        return first.red == second.red && first.green == second.green && first.blue == second.blue && first.alpha == second.alpha;
    }
}
