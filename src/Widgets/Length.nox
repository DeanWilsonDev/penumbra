Point :: import Point;

LengthUnit :: enum {
    Logical,
    Percent,
    ViewportWidth,
    ViewportHeight
}

Length :: struct {
    value~ f32 = -1.0f;
    unit~ LengthUnit = LengthUnit:::Logical;

    IsSet :: () -> bool {
        return value >= 0.0f;
    }

    Resolve :: (percentBasisLogical: f32, viewportLogical: Point) -> f32 {
        return when unit {
            LengthUnit:::Logical -> value,
            LengthUnit:::Percent -> percentBasisLogical * value / 100.0f,
            LengthUnit:::ViewportWidth -> viewportLogical.x * value / 100.0f,
            LengthUnit:::ViewportHeight -> viewportLogical.y * value / 100.0f
        };
    }

    static Logical :: (value: f32) -> Length {
        return Length { value: value, unit: LengthUnit:::Logical };
    }

    static Percent :: (value: f32) -> Length {
        return Length { value: value, unit: LengthUnit:::Percent };
    }

    static ViewportWidth :: (value: f32) -> Length {
        return Length { value: value, unit: LengthUnit:::ViewportWidth };
    }

    static ViewportHeight :: (value: f32) -> Length {
        return Length { value: value, unit: LengthUnit:::ViewportHeight };
    }
}
