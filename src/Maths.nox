CMath :: foreign "m" {
    expf :: (value: f32) -> f32;
    lroundf :: (value: f32) -> i64;
    log10f :: (value: f32) -> f32;
}

Maths :: namespace {
    Exp :: (value: f32) -> f32 {
        unsafe {
            return CMath:::expf(value);
        }
    }

    RoundToInteger :: (value: f32) -> i64 {
        unsafe {
            return CMath:::lroundf(value);
        }
    }

    Log10 :: (value: f32) -> f32 {
        unsafe {
            return CMath:::log10f(value);
        }
    }

    IsFinite :: (value: f32) -> bool {
        return value - value == 0.0f;
    }
}
