Maths :: import Maths;

Point :: struct {
    x~ f32 = 0.0f;
    y~ f32 = 0.0f;
}

Rect :: struct {
    x~ f32 = 0.0f;
    y~ f32 = 0.0f;
    width~ f32 = 0.0f;
    height~ f32 = 0.0f;

    Contains :: (point: Point) -> bool {
        return point.x >= x && point.y >= y && point.x < x + width && point.y < y + height;
    }
}

Transform :: struct {
    scaleX~ f32 = 1.0f;
    scaleY~ f32 = 1.0f;
    translateXLogical~ f32 = 0.0f;
    translateYLogical~ f32 = 0.0f;
    rotationDegrees~ f32 = 0.0f;

    IsIdentity :: () -> bool {
        return scaleX == 1.0f && scaleY == 1.0f && translateXLogical == 0.0f && translateYLogical == 0.0f && rotationDegrees == 0.0f;
    }
}

Numbers :: namespace {
    NonNegative :: (value: f32) -> f32 {
        if value > 0.0f {
            return value;
        }
        return 0.0f;
    }

    Larger :: (first: f32, second: f32) -> f32 {
        if first > second {
            return first;
        }
        return second;
    }

    Smaller :: (first: f32, second: f32) -> f32 {
        if first < second {
            return first;
        }
        return second;
    }

    LargerIndex :: (first: usize, second: usize) -> usize {
        if first > second {
            return first;
        }
        return second;
    }

    SmallerIndex :: (first: usize, second: usize) -> usize {
        if first < second {
            return first;
        }
        return second;
    }
}

Transforms :: namespace {
    InversePoint :: (screenPoint: Point, pivot: Point, transform: Transform) -> Point {
        offsetX: f32 = screenPoint.x - pivot.x - transform.translateXLogical;
        offsetY: f32 = screenPoint.y - pivot.y - transform.translateYLogical;
        radians: f32 = -transform.rotationDegrees * Maths:::RadiansPerDegree();
        cosine: f32 = Maths:::Cos(radians);
        sine: f32 = Maths:::Sin(radians);
        rotatedX: f32 = offsetX * cosine - offsetY * sine;
        rotatedY: f32 = offsetX * sine + offsetY * cosine;
        scaleX~ f32 = transform.scaleX;
        if scaleX == 0.0f {
            scaleX = 1.0f;
        }
        scaleY~ f32 = transform.scaleY;
        if scaleY == 0.0f {
            scaleY = 1.0f;
        }
        return Point { x: pivot.x + rotatedX / scaleX, y: pivot.y + rotatedY / scaleY };
    }
}
