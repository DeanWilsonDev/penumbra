            Key:::NumpadDivide -> "/",
            Key:::NumpadDecimal -> ".",
            Key:::NumpadEnter -> "Enter"
        };
    }
}

InputState :: struct {
    mousePosition~ Point = Point { };
    mouseButtonDown~ bool[3] = [false, false, false];
    mouseButtonPressedThisFrame~ bool[3] = [false, false, false];
    mouseButtonReleasedThisFrame~ bool[3] = [false, false, false];
    mouseWheelDelta~ f32 = 0.0f;
    mouseWheelDeltaX~ f32 = 0.0f;
    modifierState~ Modifiers = Modifiers { };
    deltaTimeSeconds~ f32 = 0.0f;
    pointerOccluded~ bool = false;
    pointerPassThrough~ bool = false;
    textInputThisFrame~ string = "";
    keysPressedThisFrame~ Array<Key> = [];
    keyEvents~ Array<KeyEvent> = [];

    IsPointerOver :: (area: Rect) -> bool {
        return !pointerOccluded && !pointerPassThrough
            && mousePosition.x >= area.x && mousePosition.x < area.x + area.width
            && mousePosition.y >= area.y && mousePosition.y < area.y + area.height;
    }

    Occluded :: () -> InputState {
        occluded~ InputState = InputState {
            mousePosition: mousePosition,
            mouseButtonDown: mouseButtonDown,
            mouseButtonPressedThisFrame: mouseButtonPressedThisFrame,
            mouseButtonReleasedThisFrame: mouseButtonReleasedThisFrame,
            mouseWheelDelta: mouseWheelDelta,
            mouseWheelDeltaX: mouseWheelDeltaX,
            modifierState: modifierState,
            deltaTimeSeconds: deltaTimeSeconds,
            pointerOccluded: true,
            pointerPassThrough: pointerPassThrough,
            textInputThisFrame: textInputThisFrame,
            keysPressedThisFrame: keysPressedThisFrame,
            keyEvents: keyEvents
        };
        return occluded;
    }
}
