            Key:::RightBracket -> "]",
            Key:::Backslash -> "\\",
            Key:::Semicolon -> ";",
            Key:::Apostrophe -> "'",
            Key:::Grave -> "`",
            Key:::Comma -> ",",
            Key:::Period -> ".",
            Key:::Slash -> "/",
            Key:::LeftShift -> "Shift",
            Key:::RightShift -> "Shift",
            Key:::LeftControl -> "Control",
            Key:::RightControl -> "Control",
            Key:::LeftAlt -> "Alt",
            Key:::RightAlt -> "Alt",
