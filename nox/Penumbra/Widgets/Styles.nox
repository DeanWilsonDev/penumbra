Color :: import Color;
Transform :: import Transform;
Length :: import Length;
Easing :: import Easing;

EdgeInsets :: struct {
    left~ f32 = 0.0f;
    top~ f32 = 0.0f;
    right~ f32 = 0.0f;
    bottom~ f32 = 0.0f;

    Horizontal :: () -> f32 {
        return left + right;
    }

    Vertical :: () -> f32 {
        return top + bottom;
    }
}

Insets :: namespace {
    All :: (value: f32) -> EdgeInsets {
        return EdgeInsets { left: value, top: value, right: value, bottom: value };
    }

    Symmetric :: (horizontal: f32, vertical: f32) -> EdgeInsets {
        return EdgeInsets { left: horizontal, top: vertical, right: horizontal, bottom: vertical };
    }
}

LayoutMode :: enum {
    None,
    VerticalStack,
    HorizontalStack,
    FixedLeadingStack
}

CrossAlign :: enum {
    Start,
    Center,
    End,
    Stretch
}

Justify :: enum {
    Start,
    Center,
    End,
    SpaceBetween
}

Position :: enum {
    Static,
    Relative,
    Absolute,
    Fixed,
    Sticky
}

PointerEvents :: enum {
    Inherit,
    Auto,
    None
}

Placement :: struct {
    positionMode~ Position = Position:::Static;
    top~ Length? = null;
    right~ Length? = null;
    bottom~ Length? = null;
    left~ Length? = null;
    hasWidth~ bool = false;
    hasHeight~ bool = false;
    zIndex~ i32? = null;
    pointerEventsMode~ PointerEvents = PointerEvents:::Inherit;
}

TransitionSpec :: struct {
    durationSeconds~ f32 = 0.0f;
    curve~ Easing = Easing:::Linear;
}

BoxStyle :: struct {
    colorBackground~ Color = Color { };
    colorBorder~ Color = Color { };
    colorBackgroundHovered~ Color = Color { };
    colorBackgroundPressed~ Color = Color { };
    colorBackgroundDisabled~ Color = Color { };
    colorBorderHovered~ Color = Color { };
    colorBorderPressed~ Color = Color { };
    colorBorderDisabled~ Color = Color { };
    borderWidth~ f32 = 0.0f;
    borderRadius~ f32 = 0.0f;
    gradientTop~ Color = Color { };
    gradientBottom~ Color = Color { };
    gradientTopHovered~ Color = Color { };
    gradientBottomHovered~ Color = Color { };
    gradientTopPressed~ Color = Color { };
    gradientBottomPressed~ Color = Color { };
    shadowColor~ Color = Color { };
    shadowBlurRadiusLogical~ f32 = 0.0f;
    padding~ EdgeInsets = EdgeInsets { };
    margin~ EdgeInsets = EdgeInsets { };
    width~ Length = Length { };
    height~ Length = Length { };
    minWidth~ Length = Length { };
    maxWidth~ Length = Length { };
    flexGrow~ f32 = 0.0f;
    opacity~ f32 = 1.0f;
    positionMode~ Position = Position:::Static;
    top~ Length? = null;
    right~ Length? = null;
    bottom~ Length? = null;
    left~ Length? = null;
    zIndex~ i32? = null;
    pointerEventsMode~ PointerEvents = PointerEvents:::Inherit;
    transform~ Transform = Transform { };
    widthTransition~ TransitionSpec? = null;
    heightTransition~ TransitionSpec? = null;
    flexGrowTransition~ TransitionSpec? = null;
    backgroundColorTransition~ TransitionSpec? = null;
    opacityTransition~ TransitionSpec? = null;

    PlacementOf :: () -> Placement {
        return Placement {
            positionMode: positionMode,
            top: top,
            right: right,
            bottom: bottom,
            left: left,
            hasWidth: width.IsSet(),
            hasHeight: height.IsSet(),
            zIndex: zIndex,
            pointerEventsMode: pointerEventsMode
        };
    }

    HasTransitions :: () -> bool {
        return widthTransition != null || heightTransition != null || flexGrowTransition != null
            || backgroundColorTransition != null || opacityTransition != null;
    }

    HasInteractionColors :: () -> bool {
        return colorBackgroundHovered.IsVisible() || colorBackgroundPressed.IsVisible()
            || colorBorderHovered.IsVisible() || colorBorderPressed.IsVisible();
    }
}
