Point :: import Point;
Rect :: import Rect;
Color :: import Color;
IRenderer :: import IRenderer;
RoundedRects :: import RoundedRects;
InputState :: import InputState;
MouseButton :: import MouseButton;
StackingTracker :: import StackingTracker;
Box :: import Box;

Checkbox :: class : Box {
public:
    colorCheckMark~ Color = Color { };
    colorBoxChecked~ Color = Color { };
    glyphSizeLogical~ f32 = 0.0f;
    checked~ bool = false;
    onCheckedChanged~ ((checked: bool) -> void)!? = null;

    !Checkbox~: () {
        delete this->onCheckedChanged;
    }

    TakesPointerFromTextSelection :: () -> bool override {
        return true;
    }

    UpdateInteractionState~: (input: InputState, stacking: StackingTracker~*) -> bool override {
        if !this->isEnabled {
            this->pressBeganInside = false;
            return false;
        }
        left: usize = MouseButton:::Left();
        hovered: bool = input.IsPointerOver(this->arrangedRect);
        pressed: bool = input.mouseButtonPressedThisFrame[left];
        released: bool = input.mouseButtonReleasedThisFrame[left];

        if pressed && hovered {
            this->pressBeganInside = true;
        }
        if released {
            if this->pressBeganInside && hovered {
                this->checked = !this->checked;
                if handler := this->onCheckedChanged {
                    handler(this->checked);
                }
            }
            this->pressBeganInside = false;
        }
        return hovered;
    }

protected:
    MeasureContent~: (availableContentSize: Point) -> Point override {
        return Point { x: this->glyphSizeLogical, y: this->glyphSizeLogical };
    }

    DrawContent~: (renderer: IRenderer~*, contentRect: Rect) -> void override {
        if !this->checked {
            return;
        }
        RoundedRects:::Fill(renderer, contentRect, this->colorBoxChecked, this->style.borderRadius);
        markInsetRatio: f32 = 0.25f;
        insetX: f32 = contentRect.width * markInsetRatio;
        insetY: f32 = contentRect.height * markInsetRatio;
        mark: Rect = Rect {
            x: contentRect.x + insetX,
            y: contentRect.y + insetY,
            width: contentRect.width - 2.0f * insetX,
            height: contentRect.height - 2.0f * insetY
        };
        RoundedRects:::Fill(renderer, mark, this->colorCheckMark, this->style.borderRadius * 0.6f);
    }

private:
    pressBeganInside~ bool = false;
}
