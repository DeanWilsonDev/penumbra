Point :: import Point;
Rect :: import Rect;
EdgeInsets :: import EdgeInsets;
IRenderer :: import IRenderer;
InputState :: import InputState;
Placement :: import Placement;
LayoutContext :: import LayoutContext;
StackingTracker :: import StackingTracker;

InteractionState :: enum {
    Default,
    Hovered,
    Pressed,
    Disabled
}

WidgetBase :: class {
public:
    className~ string = "";
    layeredBy~ u64 = 0;
    layeredAsContext~ bool = false;
    onPressed~ (() -> void)!? = null;
    onReleased~ (() -> void)!? = null;
    onHovered~ (() -> void)!? = null;
    onUnhovered~ (() -> void)!? = null;
    onFocused~ (() -> void)!? = null;
    onChanged~ (() -> void)!? = null;
    onDestroyed~ (() -> void)!? = null;

    !WidgetBase~: () {
        if handler := this->onDestroyed {
            handler();
        }
        delete this->onPressed;
        delete this->onReleased;
        delete this->onHovered;
        delete this->onUnhovered;
        delete this->onFocused;
        delete this->onChanged;
        delete this->onDestroyed;
    }

    Measure~ (availableSizeLogical: Point) -> Point : 0;
    Arrange~ (finalRectLogical: Rect, layout: LayoutContext~*) -> void : 0;
    Draw~ (renderer: IRenderer~*, stacking: StackingTracker~*) -> void : 0;
    UpdateInteractionState~ (input: InputState, stacking: StackingTracker~*) -> bool : 0;

    virtual GetMarginLogical :: () -> EdgeInsets {
        return EdgeInsets { };
    }

    virtual GetPlacement :: () -> Placement {
        return Placement { };
    }

    virtual GetFlexGrow :: () -> f32 {
        return 0.0f;
    }

    virtual GetChildCount :: () -> usize {
        return 0;
    }

    virtual GetChildAt :: (index: usize) -> WidgetBase*? {
        return null;
    }

    virtual GetMutableChildAt~: (index: usize) -> WidgetBase~*? {
        return null;
    }

    virtual GetChildClipRect :: () -> Rect? {
        return null;
    }

    virtual ConsumedWheelThisFrame :: () -> bool {
        return false;
    }

    SetIsEnabled~: (enabled: bool) -> void {
        this->isEnabled = enabled;
    }

    GetIsEnabled :: () -> bool {
        return this->isEnabled;
    }

    SetIsVisible~: (visible: bool) -> void {
        this->isVisible = visible;
    }

    GetIsVisible :: () -> bool {
        return this->isVisible;
    }

    GetArrangedRect :: () -> Rect {
        return this->arrangedRect;
    }

    GetInteractionState :: () -> InteractionState {
        return this->currentState;
    }

    HasCallbacks :: () -> bool {
        return this->onPressed != null || this->onReleased != null || this->onHovered != null
            || this->onUnhovered != null || this->onFocused != null || this->onChanged != null;
    }

protected:
    isEnabled~ bool = true;
    isVisible~ bool = true;
    arrangedRect~ Rect = Rect { };
    currentState~ InteractionState = InteractionState:::Default;
}
