Point :: import Point;
Rect :: import Rect;
InputState :: import InputState;
Key :: import Key;
KeyEvent :: import KeyEvent;
WidgetBase :: import WidgetBase;

KeyDispatch :: class {
public:
    viewportLogical~ Point = Point { };

    !KeyDispatch~: () {
        delete this->presses;
        delete this->events;
        delete this->used;
        delete this->usedForEvents;
    }

    Begin~: (root: WidgetBase~*, input: InputState) -> bool {
        if this->open {
            return false;
        }
        this->open = true;
        this->root = root;
        this->target = null;
        this->withheld = false;
        this->presses.clear();
        this->events.clear();
        this->used.clear();
        for key in input.keysPressedThisFrame {
            this->presses.push(key);
        }
        for event in input.keyEvents {
            this->events.push(event);
        }
        if this->events.length() == 0 {
            for key in input.keysPressedThisFrame {
                this->events.push(KeyEvent { code: key, down: true, repeat: false, modifierState: input.modifierState });
            }
        }
        return true;
    }

    End~: (outermost: bool) -> void {
        if !outermost {
            return;
        }
        this->open = false;
        chosen~ WidgetBase~*? = this->target;
        if chosen == null && !this->withheld {
            if passRoot := this->root {
                if passRoot->onKeyPressed != null || passRoot->onKeyEvent != null {
                    chosen = passRoot;
                }
            }
        }
        this->root = null;
        this->target = null;
        guard receiver := chosen;
        this->usedForEvents.clear();
        for key in this->used {
            this->usedForEvents.push(key);
        }
        if handler := receiver->onKeyPressed {
            for key in this->presses {
                if this->TakeUsed(key) {
                    continue;
                }
                handler(key);
            }
        }
        if handler := receiver->onKeyEvent {
            for event in this->events {
                if event.down && this->TakeUsedForEvents(event.code) {
                    continue;
                }
                handler(event);
            }
        }
    }

    MarkUsed~: (key: Key) -> void {
        if this->open {
            this->used.push(key);
        }
    }

    ForChild :: (input: InputState) -> InputState {
        if !this->withheld || (input.keysPressedThisFrame.length() == 0 && input.keyEvents.length() == 0 && input.textInputThisFrame.length() == 0) {
            return input;
        }
        stripped~ InputState = input;
        stripped.keysPressedThisFrame = [];
        stripped.keyEvents = [];
        stripped.textInputThisFrame = "";
        return stripped;
    }

    AfterChild~: (child: WidgetBase~*, given: InputState) -> void {
        if !this->open {
            return;
        }
        hasPresses: bool = given.keysPressedThisFrame.length() > 0;
        hasEvents: bool = hasPresses || given.keyEvents.length() > 0;
        if this->target == null && ((child->onKeyPressed != null && hasPresses) || (child->onKeyEvent != null && hasEvents)) {
            this->target = child;
        }
        if !given.pointerPassThrough && this->CoversWindow(child->GetArrangedRect()) {
            this->withheld = true;
        }
    }

private:
    open~ bool = false;
    root~ WidgetBase~*? = null;
    target~ WidgetBase~*? = null;
    withheld~ bool = false;
    presses~ Array<Key>! = [];
    events~ Array<KeyEvent>! = [];
    used~ Array<Key>! = [];
    usedForEvents~ Array<Key>! = [];

    TakeUsedForEvents~: (key: Key) -> bool {
        index~ usize = 0;
        while index < this->usedForEvents.length() {
            if this->usedForEvents[index] == key {
                this->usedForEvents.remove(index);
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    TakeUsed~: (key: Key) -> bool {
        index~ usize = 0;
        while index < this->used.length() {
            if this->used[index] == key {
                this->used.remove(index);
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    CoversWindow :: (area: Rect) -> bool {
        if this->viewportLogical.x <= 0.0f || this->viewportLogical.y <= 0.0f {
            return false;
        }
        slack: f32 = 0.5f;
        return area.x <= slack && area.y <= slack && area.x + area.width >= this->viewportLogical.x - slack
            && area.y + area.height >= this->viewportLogical.y - slack;
    }
}

