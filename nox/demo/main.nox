PressCounter :: struct {
    presses~ i32 = 0;
}

MakeLabel :: (font: IFontBackend*, text: string, sizeLogical: f32) -> Label*! {
    label: Label*! = new Label(font, text);
    label->fontSizeLogical = sizeLogical;
    label->colorText = Color { red: 230, green: 230, blue: 230, alpha: 255 };
    label->className = text;
    return label!;
}

MakeBox :: (name: string, layout: LayoutMode) -> Box*! {
    box: Box*! = new Box();
    box->className = name;
    box->layout = layout;
    return box!;
}

PrintTree :: (widget: WidgetBase*, depth: i32) -> void {
    print(depth);
    print(widget->className);
    rect: Rect = widget->GetArrangedRect();
    print(rect.x);
    print(rect.y);
    print(rect.width);
    print(rect.height);
    index~ usize = 0;
    while index < widget->GetChildCount() {
        if child := widget->GetChildAt(index) {
            PrintTree(child, depth + 1);
        }
        index = index + 1;
    }
}

BuildWindow :: (font: IFontBackend*) -> Box*! {
    window: Box*! = MakeBox("window", LayoutMode:::VerticalStack);
    window->style.padding = Insets:::All(8.0f);
    window->style.colorBackground = Color { red: 20, green: 20, blue: 24, alpha: 255 };
    window->childGap = 4.0f;
    window->crossAlignment = CrossAlign:::Stretch;

    header: Box*! = MakeBox("header", LayoutMode:::HorizontalStack);
    header->style.padding = Insets:::Symmetric(12.0f, 6.0f);
    header->style.colorBorder = Color { red: 80, green: 80, blue: 90, alpha: 255 };
    header->style.borderWidth = 1.0f;
    header->childGap = 8.0f;
    header->crossAlignment = CrossAlign:::Center;
    header->AddChild(MakeLabel(font, "Cairn", 20.0f));
    spacer: Box*! = MakeBox("spacer", LayoutMode:::None);
    spacer->style.flexGrow = 1.0f;
    header->AddChild(spacer!);
    header->AddChild(MakeLabel(font, "v0.1", 12.0f));
    window->AddChild(header!);

    body: Box*! = MakeBox("body", LayoutMode:::HorizontalStack);
    body->style.flexGrow = 1.0f;
    body->childGap = 4.0f;
    body->crossAlignment = CrossAlign:::Stretch;
    sidebar: Box*! = MakeBox("sidebar", LayoutMode:::VerticalStack);
    sidebar->style.width = Lengths:::Percent(25.0f);
    sidebar->style.colorBackground = Color { red: 30, green: 30, blue: 36, alpha: 255 };
    sidebar->AddChild(MakeLabel(font, "Epics", 14.0f));
    sidebar->AddChild(MakeLabel(font, "Features", 14.0f));
    body->AddChild(sidebar!);
    content: Box*! = MakeBox("content", LayoutMode:::FixedLeadingStack);
    content->style.flexGrow = 1.0f;
    content->leadingExtentLogical = 40.0f;
    content->childGap = 4.0f;
    content->crossAlignment = CrossAlign:::Stretch;
    content->AddChild(MakeLabel(font, "Board", 18.0f));
    content->AddChild(MakeBox("lanes", LayoutMode:::None));
    body->AddChild(content!);
    window->AddChild(body!);

    footer: Box*! = MakeBox("footer", LayoutMode:::HorizontalStack);
    footer->justifyContentMode = Justify:::SpaceBetween;
    footer->style.height = Lengths:::Logical(24.0f);
    footer->AddChild(MakeLabel(font, "3 open", 12.0f));
    footer->AddChild(MakeLabel(font, "saved", 12.0f));
    window->AddChild(footer!);
    return window!;
}

StateName :: (state: InteractionState) -> string {
    return when state {
        InteractionState:::Default -> "default",
        InteractionState:::Hovered -> "hovered",
        InteractionState:::Pressed -> "pressed",
        InteractionState:::Disabled -> "disabled"
    };
}

BuildToolbar :: () -> Box*! {
    toolbar: Box*! = MakeBox("toolbar", LayoutMode:::HorizontalStack);
    toolbar->style.padding = Insets:::All(4.0f);
    toolbar->childGap = 4.0f;
    toolbar->style.colorBackgroundHovered = Color { red: 40, green: 40, blue: 48, alpha: 255 };

    button: Box*! = MakeBox("button", LayoutMode:::None);
    button->style.width = Lengths:::Logical(80.0f);
    button->style.height = Lengths:::Logical(24.0f);
    button->style.colorBackground = Color { red: 60, green: 60, blue: 70, alpha: 255 };
    button->style.colorBackgroundHovered = Color { red: 70, green: 70, blue: 90, alpha: 255 };
    button->style.colorBackgroundPressed = Color { red: 90, green: 90, blue: 120, alpha: 255 };
    counter: PressCounter*! = new PressCounter();
    button->onPressed = new () -> void [counter!] {
        counter->presses = counter->presses + 1;
        print("button pressed");
        print(counter->presses);
    };
    button->onReleased = new () -> void [] { print("button released"); };
    button->onHovered = new () -> void [] { print("button hovered"); };
    button->onUnhovered = new () -> void [] { print("button unhovered"); };
    button->onDestroyed = new () -> void [] { print("button destroyed"); };
    toolbar->AddChild(button!);

    disabled: Box*! = MakeBox("disabled", LayoutMode:::None);
    disabled->style.width = Lengths:::Logical(80.0f);
    disabled->style.height = Lengths:::Logical(24.0f);
    disabled->style.colorBackground = Color { red: 60, green: 60, blue: 70, alpha: 255 };
    disabled->style.colorBackgroundDisabled = Color { red: 30, green: 30, blue: 30, alpha: 255 };
    disabled->onPressed = new () -> void [] { print("never printed"); };
    disabled->SetIsEnabled(false);
    toolbar->AddChild(disabled!);
    return toolbar!;
}

RunFrame :: (toolbar: Box~*, stacking: StackingTracker~*, frameName: string, x: f32, y: f32, down: bool, pressed: bool, released: bool) -> void {
    print(frameName);
    input~ InputState = InputState { };
    input.mousePosition = Point { x: x, y: y };
    input.mouseButtonDown[0] = down;
    input.mouseButtonPressedThisFrame[0] = pressed;
    input.mouseButtonReleasedThisFrame[0] = released;
    consumed: bool = toolbar->UpdateInteractionState(input, stacking);
    print(consumed);
    print(StateName(toolbar->GetInteractionState()));
    index~ usize = 0;
    while index < toolbar->GetChildCount() {
        if child := toolbar->GetChildAt(index) {
            print(StateName(child->GetInteractionState()));
        }
        index = index + 1;
    }
}

SimulateInput :: () -> void {
    toolbar: Box*! = BuildToolbar();
    defer delete toolbar;
    toolbar->Measure(Point { x: 400.0f, y: 100.0f });
    layout: LayoutContext*! = new LayoutContext();
    defer delete layout;
    toolbar->Arrange(Rect { x: 0.0f, y: 0.0f, width: 400.0f, height: 32.0f }, layout);
    stacking: StackingTracker*! = new StackingTracker();
    defer delete stacking;
    RunFrame(toolbar, stacking, "frame outside", 300.0f, 200.0f, false, false, false);
    RunFrame(toolbar, stacking, "frame over toolbar", 300.0f, 10.0f, false, false, false);
    RunFrame(toolbar, stacking, "frame over button", 20.0f, 10.0f, false, false, false);
    RunFrame(toolbar, stacking, "frame press", 20.0f, 10.0f, true, true, false);
    RunFrame(toolbar, stacking, "frame hold", 21.0f, 11.0f, true, false, false);
    RunFrame(toolbar, stacking, "frame release", 21.0f, 11.0f, false, false, true);
    RunFrame(toolbar, stacking, "frame press disabled", 100.0f, 10.0f, true, true, false);
    RunFrame(toolbar, stacking, "frame release disabled", 100.0f, 10.0f, false, false, true);
    RunFrame(toolbar, stacking, "frame second press", 20.0f, 10.0f, true, true, false);
    RunFrame(toolbar, stacking, "frame drag off", 300.0f, 10.0f, true, false, false);
    RunFrame(toolbar, stacking, "frame release outside", 300.0f, 10.0f, false, false, true);

    renderer: RecordingRenderer*! = new RecordingRenderer();
    defer delete renderer;
    toolbar->Draw(renderer, stacking);
}

MakeSizedBox :: (name: string, width: f32, height: f32) -> Box*! {
    box: Box*! = MakeBox(name, LayoutMode:::None);
    box->style.width = Lengths:::Logical(width);
    box->style.height = Lengths:::Logical(height);
    return box!;
}

BuildPositionedPanel :: () -> Box*! {
    panel: Box*! = MakeBox("panel", LayoutMode:::VerticalStack);
    panel->style.positionMode = Position:::Relative;
    panel->style.padding = Insets:::All(10.0f);
    panel->style.borderWidth = 2.0f;
    panel->childGap = 4.0f;

    panel->AddChild(MakeSizedBox("static", 100.0f, 50.0f));

    relative: Box*! = MakeSizedBox("relative", 100.0f, 20.0f);
    relative->style.positionMode = Position:::Relative;
    relative->style.top = Lengths:::Logical(5.0f);
    relative->style.left = Lengths:::Percent(10.0f);
    panel->AddChild(relative!);

    corner: Box*! = MakeSizedBox("absolute corner", 40.0f, 20.0f);
    corner->style.positionMode = Position:::Absolute;
    corner->style.top = Lengths:::Logical(8.0f);
    corner->style.right = Lengths:::Logical(8.0f);
    panel->AddChild(corner!);

    strip: Box*! = MakeBox("absolute strip", LayoutMode:::None);
    strip->style.height = Lengths:::Logical(10.0f);
    strip->style.positionMode = Position:::Absolute;
    strip->style.left = Lengths:::Logical(0.0f);
    strip->style.right = Lengths:::Logical(0.0f);
    strip->style.bottom = Lengths:::Logical(0.0f);
    panel->AddChild(strip!);

    floating: Box*! = MakeSizedBox("absolute static", 30.0f, 30.0f);
    floating->style.positionMode = Position:::Absolute;
    panel->AddChild(floating!);

    badge: Box*! = MakeSizedBox("fixed badge", 24.0f, 12.0f);
    badge->style.positionMode = Position:::Fixed;
    badge->style.bottom = Lengths:::Logical(4.0f);
    badge->style.right = Lengths:::Logical(4.0f);
    panel->AddChild(badge!);

    sticky: Box*! = MakeSizedBox("sticky", 100.0f, 16.0f);
    sticky->style.positionMode = Position:::Sticky;
    sticky->style.top = Lengths:::Logical(0.0f);
    panel->AddChild(sticky!);
    return panel!;
}

ShowPositioning :: () -> void {
    print("positioning");
    panel: Box*! = BuildPositionedPanel();
    defer delete panel;
    layout: LayoutContext*! = new LayoutContext();
    defer delete layout;
    layout->viewportLogical = Point { x: 640.0f, y: 360.0f };
    desired: Point = panel->Measure(Point { x: 300.0f, y: 200.0f });
    print(desired.x);
    print(desired.y);
    panel->Arrange(Rect { x: 20.0f, y: -120.0f, width: 300.0f, height: 200.0f }, layout);
    PrintTree(panel, 0);
}

ClippingBox :: class : Box {
public:
    GetChildClipRect :: () -> Rect? override {
        return this->ContentRectFrom(this->arrangedRect);
    }
}

MakeLayer :: (name: string, red: u8, width: f32, height: f32) -> Box*! {
    layer: Box*! = MakeSizedBox(name, width, height);
    layer->style.colorBackground = Color { red: red, green: 0, blue: 0, alpha: 255 };
    layer->style.colorBackgroundHovered = Color { red: red, green: 255, blue: 0, alpha: 255 };
    return layer!;
}

BuildStage :: () -> ClippingBox*! {
    stage: ClippingBox*! = new ClippingBox();
    stage->className = "stage";
    stage->layout = LayoutMode:::VerticalStack;
    stage->style.positionMode = Position:::Relative;
    stage->style.padding = Insets:::All(5.0f);
    stage->style.colorBackground = Color { red: 1, green: 0, blue: 0, alpha: 255 };

    low: Box*! = MakeLayer("low", 2, 50.0f, 50.0f);
    low->style.positionMode = Position:::Absolute;
    low->style.zIndex = -1;
    low->style.left = Lengths:::Logical(0.0f);
    low->style.top = Lengths:::Logical(0.0f);
    stage->AddChild(low!);

    stage->AddChild(MakeLayer("card", 3, 100.0f, 60.0f));

    overlay: Box*! = MakeLayer("overlay", 4, 40.0f, 40.0f);
    overlay->style.positionMode = Position:::Absolute;
    overlay->style.zIndex = 2;
    overlay->style.left = Lengths:::Logical(20.0f);
    overlay->style.top = Lengths:::Logical(20.0f);
    stage->AddChild(overlay!);

    popup: Box*! = MakeLayer("popup", 5, 30.0f, 30.0f);
    popup->style.positionMode = Position:::Fixed;
    popup->style.zIndex = 1;
    popup->style.right = Lengths:::Logical(0.0f);
    popup->style.bottom = Lengths:::Logical(0.0f);
    stage->AddChild(popup!);

    badge: Box*! = MakeLayer("badge", 6, 20.0f, 10.0f);
    badge->style.positionMode = Position:::Relative;
    badge->style.left = Lengths:::Logical(90.0f);
    badge->style.pointerEventsMode = PointerEvents:::None;
    stage->AddChild(badge!);
    return stage!;
}

PointAt :: (stage: Box~*, stacking: StackingTracker~*, x: f32, y: f32) -> void {
    print("pointer");
    print(x);
    print(y);
    input~ InputState = InputState { };
    input.mousePosition = Point { x: x, y: y };
    print(stage->UpdateInteractionState(input, stacking));
    index~ usize = 0;
    while index < stage->GetChildCount() {
        if child := stage->GetChildAt(index) {
            print(child->className);
            print(StateName(child->GetInteractionState()));
        }
        index = index + 1;
    }
}

ShowStacking :: () -> void {
    print("stacking");
    stage: ClippingBox*! = BuildStage();
    defer delete stage;
    layout: LayoutContext*! = new LayoutContext();
    defer delete layout;
    layout->viewportLogical = Point { x: 200.0f, y: 120.0f };
    stage->Measure(Point { x: 150.0f, y: 100.0f });
    stage->Arrange(Rect { x: 10.0f, y: 10.0f, width: 150.0f, height: 100.0f }, layout);
    PrintTree(stage, 0);
    stacking: StackingTracker*! = new StackingTracker();
    defer delete stacking;
    renderer: RecordingRenderer*! = new RecordingRenderer();
    defer delete renderer;
    renderer->printsDetail = false;
    stage->Draw(renderer, stacking);
    PointAt(stage, stacking, 40.0f, 40.0f);
    PointAt(stage, stacking, 110.0f, 70.0f);
    PointAt(stage, stacking, 110.0f, 80.0f);
    PointAt(stage, stacking, 12.0f, 12.0f);
    PointAt(stage, stacking, 190.0f, 110.0f);
}

ClickCounter :: struct {
    clicks~ i32 = 0;
}

MakeButton :: (name: string, x: f32) -> Button*! {
    button: Button*! = new Button();
    button->className = name;
    button->style.width = Lengths:::Logical(80.0f);
    button->style.height = Lengths:::Logical(24.0f);
    button->style.colorBackground = Color { red: 60, green: 60, blue: 70, alpha: 255 };
    button->style.colorBackgroundHovered = Color { red: 160, green: 60, blue: 70, alpha: 255 };
    button->style.colorBackgroundPressed = Color { red: 220, green: 60, blue: 70, alpha: 255 };
    button->style.colorBackgroundDisabled = Color { red: 20, green: 20, blue: 20, alpha: 255 };
    return button!;
}

ButtonFrame :: (button: Button~*, stacking: StackingTracker~*, renderer: RecordingRenderer~*, frameName: string, x: f32, y: f32, down: bool, pressed: bool, released: bool) -> void {
    print(frameName);
    input~ InputState = InputState { };
    input.mousePosition = Point { x: x, y: y };
    input.mouseButtonDown[0] = down;
    input.mouseButtonPressedThisFrame[0] = pressed;
    input.mouseButtonReleasedThisFrame[0] = released;
    input.deltaTimeSeconds = 0.05f;
    print(button->UpdateInteractionState(input, stacking));
    print(StateName(button->GetInteractionState()));
    button->Draw(renderer, stacking);
}

ShowButtons :: () -> void {
    print("buttons");
    layout: LayoutContext*! = new LayoutContext();
    defer delete layout;
    stacking: StackingTracker*! = new StackingTracker();
    defer delete stacking;
    renderer: RecordingRenderer*! = new RecordingRenderer();
    defer delete renderer;
    renderer->printsDetail = false;

    button: Button*! = MakeButton("eased", 0.0f);
    defer delete button;
    button->backgroundTransitionSeconds = 0.1f;
    counter: ClickCounter*! = new ClickCounter();
    button->onClicked = new () -> void [counter!] {
        counter->clicks = counter->clicks + 1;
        print("clicked");
        print(counter->clicks);
    };
    button->Measure(Point { x: 200.0f, y: 100.0f });
    button->Arrange(Rect { x: 0.0f, y: 0.0f, width: 80.0f, height: 24.0f }, layout);
    ButtonFrame(button, stacking, renderer, "away", 200.0f, 200.0f, false, false, false);
    ButtonFrame(button, stacking, renderer, "hover", 10.0f, 10.0f, false, false, false);
    ButtonFrame(button, stacking, renderer, "hover again", 10.0f, 10.0f, false, false, false);
    ButtonFrame(button, stacking, renderer, "press", 10.0f, 10.0f, true, true, false);
    ButtonFrame(button, stacking, renderer, "release", 10.0f, 10.0f, false, false, true);
    ButtonFrame(button, stacking, renderer, "press then drag off", 10.0f, 10.0f, true, true, false);
    ButtonFrame(button, stacking, renderer, "dragged off", 150.0f, 10.0f, true, false, false);
    ButtonFrame(button, stacking, renderer, "released off", 150.0f, 10.0f, false, false, true);
    button->SetIsEnabled(false);
    ButtonFrame(button, stacking, renderer, "disabled", 10.0f, 10.0f, false, false, false);

    rotated: Button*! = MakeButton("rotated", 0.0f);
    defer delete rotated;
    rotated->style.transform = Transform { rotationDegrees: 90.0f };
    rotated->Measure(Point { x: 200.0f, y: 100.0f });
    rotated->Arrange(Rect { x: 0.0f, y: 40.0f, width: 80.0f, height: 24.0f }, layout);
    ButtonFrame(rotated, stacking, renderer, "rotated: inside the turned box", 40.0f, 20.0f, false, false, false);
    ButtonFrame(rotated, stacking, renderer, "rotated: inside the unturned box only", 5.0f, 52.0f, false, false, false);

    checkbox: Checkbox*! = new Checkbox();
    defer delete checkbox;
    checkbox->glyphSizeLogical = 16.0f;
    checkbox->style.padding = Insets:::All(2.0f);
    checkbox->colorBoxChecked = Color { red: 40, green: 120, blue: 200, alpha: 255 };
    checkbox->colorCheckMark = Color { red: 250, green: 250, blue: 250, alpha: 255 };
    checkbox->onCheckedChanged = new (checked: bool) -> void [] {
        print("checked changed");
        print(checked);
    };
    measured: Point = checkbox->Measure(Point { x: 200.0f, y: 100.0f });
    print(measured.x);
    checkbox->Arrange(Rect { x: 0.0f, y: 80.0f, width: measured.x, height: measured.y }, layout);
    clickAt: InputState = InputState { mousePosition: Point { x: 5.0f, y: 85.0f } };
    pressedInput~ InputState = clickAt;
    pressedInput.mouseButtonPressedThisFrame[0] = true;
    pressedInput.mouseButtonDown[0] = true;
    releasedInput~ InputState = clickAt;
    releasedInput.mouseButtonReleasedThisFrame[0] = true;
    checkbox->UpdateInteractionState(pressedInput, stacking);
    checkbox->UpdateInteractionState(releasedInput, stacking);
    renderer->printsDetail = true;
    checkbox->Draw(renderer, stacking);
    checkbox->UpdateInteractionState(pressedInput, stacking);
    checkbox->UpdateInteractionState(releasedInput, stacking);
    checkbox->Draw(renderer, stacking);
    print(checkbox->checked);
}

ScrollFrame :: (panel: ScrollablePanel~*, stacking: StackingTracker~*, layout: LayoutContext~*, frameName: string, x: f32, y: f32, down: bool, pressed: bool, wheel: f32) -> void {
    print(frameName);
    input~ InputState = InputState { };
    input.mousePosition = Point { x: x, y: y };
    input.mouseButtonDown[0] = down;
    input.mouseButtonPressedThisFrame[0] = pressed;
    input.mouseWheelDelta = wheel;
    print(panel->UpdateInteractionState(input, stacking));
    print(panel->ConsumedWheelThisFrame());
    panel->Arrange(Rect { x: 0.0f, y: 0.0f, width: 100.0f, height: 60.0f }, layout);
    print(panel->GetScrollOffset());
    if first := panel->GetChildAt(0) {
        print(first->GetArrangedRect().y);
    }
}

ShowScrolling :: () -> void {
    print("scrolling");
    layout: LayoutContext*! = new LayoutContext();
    defer delete layout;
    stacking: StackingTracker*! = new StackingTracker();
    defer delete stacking;
    panel: ScrollablePanel*! = new ScrollablePanel();
    defer delete panel;
    panel->className = "list";
    panel->crossAlignment = CrossAlign:::Stretch;
    panel->wheelStepLogical = 10.0f;
    panel->scrollbarWidthLogical = 6.0f;
    panel->colorScrollbarTrack = Color { red: 30, green: 30, blue: 30, alpha: 255 };
    panel->colorScrollbarThumb = Color { red: 90, green: 90, blue: 90, alpha: 255 };
    panel->colorScrollbarThumbHovered = Color { red: 140, green: 140, blue: 140, alpha: 255 };
    rowIndex~ i32 = 0;
    while rowIndex < 5 {
        row: Box*! = MakeSizedBox("row", 40.0f, 20.0f);
        row->style.colorBackground = Color { red: u8(50 + rowIndex * 10), green: 50, blue: 60, alpha: 255 };
        panel->AddChild(row!);
        rowIndex = rowIndex + 1;
    }
    desired: Point = panel->Measure(Point { x: 100.0f, y: 60.0f });
    print(desired.x);
    print(desired.y);
    panel->Arrange(Rect { x: 0.0f, y: 0.0f, width: 100.0f, height: 60.0f }, layout);
    PrintTree(panel, 0);

    ScrollFrame(panel, stacking, layout, "wheel down once", 30.0f, 30.0f, false, false, -1.0f);
    ScrollFrame(panel, stacking, layout, "wheel past the end", 30.0f, 30.0f, false, false, -10.0f);
    ScrollFrame(panel, stacking, layout, "wheel outside", 300.0f, 30.0f, false, false, 1.0f);
    ScrollFrame(panel, stacking, layout, "press the track above the thumb", 97.0f, 5.0f, true, true, 0.0f);
    ScrollFrame(panel, stacking, layout, "drag the thumb", 97.0f, 30.0f, true, false, 0.0f);
    ScrollFrame(panel, stacking, layout, "drag beyond the panel", 97.0f, 200.0f, true, false, 0.0f);
    ScrollFrame(panel, stacking, layout, "release", 97.0f, 200.0f, false, false, 0.0f);
    ScrollFrame(panel, stacking, layout, "hover the rows", 30.0f, 30.0f, false, false, 0.0f);

    renderer: RecordingRenderer*! = new RecordingRenderer();
    defer delete renderer;
    panel->Draw(renderer, stacking);
}

PointerAt :: (x: f32, pressed: bool, down: bool, released: bool) -> InputState {
    input~ InputState = InputState { };
    input.mousePosition = Point { x: x, y: 10.0f };
    input.mouseButtonPressedThisFrame[0] = pressed;
    input.mouseButtonDown[0] = down;
    input.mouseButtonReleasedThisFrame[0] = released;
    return input;
}

EditFrame :: (field: TextInput~*, stacking: StackingTracker~*, label: string, input: InputState) -> void {
    print(label);
    print(field->UpdateInteractionState(input, stacking));
    print(field->text);
}

ShowTextInput :: (font: IFontBackend*) -> void {
    print("text input");
    focusState: FocusState*! = new FocusState { };
    defer delete focusState;
    clipboard: RecordingClipboard*! = new RecordingClipboard();
    defer delete clipboard;
    layout: LayoutContext*! = new LayoutContext();
    defer delete layout;
    stacking: StackingTracker*! = new StackingTracker();
    defer delete stacking;
    renderer: RecordingRenderer*! = new RecordingRenderer();
    defer delete renderer;
    field: TextInput*! = new TextInput(font);
    defer delete field;
    field->className = "field";
    field->style.padding = Insets:::All(4.0f);
    field->preferredWidthLogical = 100.0f;
    field->caretWidthLogical = 1.0f;
    field->colorText = Color { red: 230, green: 230, blue: 230, alpha: 255 };
    field->colorCaret = Color { red: 255, green: 255, blue: 255, alpha: 255 };
    field->colorSelection = Color { red: 40, green: 80, blue: 160, alpha: 255 };
    field->focus = focusState;
    field->clipboard = clipboard;
    field->onTextChanged = new (text: string) -> void {
        print("text changed");
    };
    field->onFocusLost = new () -> void {
        print("focus lost");
    };
    desired: Point = field->Measure(Point { x: 640.0f, y: 360.0f });
    print(desired.x);
    print(desired.y);
    field->Arrange(Rect { x: 0.0f, y: 0.0f, width: desired.x, height: desired.y }, layout);
    PrintTree(field, 0);

    EditFrame(field, stacking, "type before focus", PointerAt(24.0f, false, false, false));
    EditFrame(field, stacking, "click to focus", PointerAt(24.0f, true, true, false));
    typed~ InputState = PointerAt(24.0f, false, false, true);
    typed.textInputThisFrame = "héllo";
    EditFrame(field, stacking, "type", typed);

    stepBack: Key[2] = [Key:::Left, Key:::Left];
    stepping~ InputState = PointerAt(24.0f, false, false, false);
    stepping.keysPressedThisFrame = stepBack.borrow();
    EditFrame(field, stacking, "left twice", stepping);

    erase: Key[1] = [Key:::Backspace];
    erasing~ InputState = PointerAt(24.0f, false, false, false);
    erasing.keysPressedThisFrame = erase.borrow();
    EditFrame(field, stacking, "backspace", erasing);

    deleteWide: Key[2] = [Key:::Left, Key:::Delete];
    deleting~ InputState = PointerAt(24.0f, false, false, false);
    deleting.keysPressedThisFrame = deleteWide.borrow();
    EditFrame(field, stacking, "left then delete a two-byte letter", deleting);

    selectToEnd: Key[1] = [Key:::End];
    selecting~ InputState = PointerAt(24.0f, false, false, false);
    selecting.keysPressedThisFrame = selectToEnd.borrow();
    selecting.modifierState.shift = true;
    EditFrame(field, stacking, "shift end", selecting);
    field->Draw(renderer, stacking);

    copyKeys: Key[1] = [Key:::C];
    copying~ InputState = PointerAt(24.0f, false, false, false);
    copying.keysPressedThisFrame = copyKeys.borrow();
    copying.modifierState.shortcut = true;
    EditFrame(field, stacking, "copy", copying);

    endKeys: Key[1] = [Key:::End];
    ending~ InputState = PointerAt(24.0f, false, false, false);
    ending.keysPressedThisFrame = endKeys.borrow();
    EditFrame(field, stacking, "end", ending);

    pasteKeys: Key[1] = [Key:::V];
    pasting~ InputState = PointerAt(24.0f, false, false, false);
    pasting.keysPressedThisFrame = pasteKeys.borrow();
    pasting.modifierState.shortcut = true;
    EditFrame(field, stacking, "paste", pasting);

    dragStart: InputState = PointerAt(4.0f, true, true, false);
    EditFrame(field, stacking, "press at the start", dragStart);
    EditFrame(field, stacking, "drag", PointerAt(21.0f, false, true, false));
    EditFrame(field, stacking, "release", PointerAt(21.0f, false, false, true));
    field->Draw(renderer, stacking);

    cutKeys: Key[2] = [Key:::A, Key:::X];
    cutting~ InputState = PointerAt(24.0f, false, false, false);
    cutting.keysPressedThisFrame = cutKeys.borrow();
    cutting.modifierState.shortcut = true;
    EditFrame(field, stacking, "select all and cut", cutting);

    retyped~ InputState = PointerAt(24.0f, false, false, false);
    retyped.textInputThisFrame = "ok";
    EditFrame(field, stacking, "type again", retyped);
    field->Draw(renderer, stacking);

    focusState->focused = null;
    EditFrame(field, stacking, "focus moves away", PointerAt(24.0f, false, false, false));
    field->Draw(renderer, stacking);
}

KeyLabel :: (key: Key) -> string {
    if key == Key:::Escape {
        return "escape";
    }
    if key == Key:::Tab {
        return "tab";
    }
    if key == Key:::Left {
        return "left";
    }
    if key == Key:::Backspace {
        return "backspace";
    }
    return "other";
}

KeyFrame :: (root: Box~*, stacking: StackingTracker~*, label: string, input: InputState) -> void {
    print(label);
    root->UpdateInteractionState(input, stacking);
}

SetOverlayVisible :: (root: Box~*, visible: bool) -> void {
    if overlay := root->GetMutableChildAt(1) {
        overlay->SetIsVisible(visible);
    }
}

ShowKeyDispatch :: (font: IFontBackend*) -> void {
    print("key dispatch");
    focusState: FocusState*! = new FocusState { };
    defer delete focusState;
    layout: LayoutContext*! = new LayoutContext();
    defer delete layout;
    stacking: StackingTracker*! = new StackingTracker();
    defer delete stacking;
    viewport: Point = Point { x: 640.0f, y: 360.0f };
    layout->viewportLogical = viewport;
    stacking->keys->viewportLogical = viewport;

    root: Box*! = MakeBox("root", LayoutMode:::VerticalStack);
    defer delete root;
    root->onKeyPressed = new (key: Key) -> void {
        print("root key");
        print(KeyLabel(key));
    };
    field: TextInput*! = new TextInput(font);
    field->className = "field";
    field->preferredWidthLogical = 100.0f;
    field->focus = focusState;
    field->onTextChanged = new (text: string) -> void {
        print("field text");
        print(text);
    };
    root->AddChild(field!);
    overlay: Box*! = MakeBox("modal", LayoutMode:::None);
    overlay->style.positionMode = Position:::Fixed;
    overlay->style.left = Lengths:::Logical(0.0f);
    overlay->style.top = Lengths:::Logical(0.0f);
    overlay->style.right = Lengths:::Logical(0.0f);
    overlay->style.bottom = Lengths:::Logical(0.0f);
    overlay->onKeyPressed = new (key: Key) -> void {
        print("modal key");
        print(KeyLabel(key));
    };
    root->AddChild(overlay!);
    SetOverlayVisible(root, false);

    root->Measure(viewport);
    root->Arrange(Rect { x: 0.0f, y: 0.0f, width: viewport.x, height: viewport.y }, layout);
    PrintTree(root, 0);

    KeyFrame(root, stacking, "focus the field", PointerAt(10.0f, true, true, false));

    typing~ InputState = PointerAt(10.0f, false, false, true);
    typing.textInputThisFrame = "ab";
    typingKeys: Key[2] = [Key:::Left, Key:::Escape];
    typing.keysPressedThisFrame = typingKeys.borrow();
    KeyFrame(root, stacking, "type, left and escape", typing);

    SetOverlayVisible(root, true);
    root->Arrange(Rect { x: 0.0f, y: 0.0f, width: viewport.x, height: viewport.y }, layout);
    PrintTree(root, 0);
    blocked~ InputState = PointerAt(300.0f, false, false, false);
    blocked.textInputThisFrame = "cd";
    blockedKeys: Key[2] = [Key:::Left, Key:::Escape];
    blocked.keysPressedThisFrame = blockedKeys.borrow();
    KeyFrame(root, stacking, "the modal takes every key", blocked);

    SetOverlayVisible(root, false);
    erasing~ InputState = PointerAt(300.0f, false, false, false);
    eraseKeys: Key[2] = [Key:::Backspace, Key:::Tab];
    erasing.keysPressedThisFrame = eraseKeys.borrow();
    KeyFrame(root, stacking, "backspace and tab", erasing);
}

SplitFrame :: (panel: SplitPanel~*, stacking: StackingTracker~*, layout: LayoutContext~*, label: string, x: f32, pressed: bool, down: bool, released: bool) -> void {
    print(label);
    input~ InputState = PointerAt(x, pressed, down, released);
    input.mousePosition.y = 50.0f;
    print(panel->UpdateInteractionState(input, stacking));
    panel->Arrange(Rect { x: 0.0f, y: 0.0f, width: 200.0f, height: 100.0f }, layout);
    print(panel->splitRatio);
    handle: Rect = panel->GetHandleRect();
    print(handle.x);
    print(handle.width);
}

ShowSplitPanel :: () -> void {
    print("split panel");
    layout: LayoutContext*! = new LayoutContext();
    defer delete layout;
    stacking: StackingTracker*! = new StackingTracker();
    defer delete stacking;
    panel: SplitPanel*! = new SplitPanel();
    defer delete panel;
    panel->className = "split";
    panel->handleThicknessLogical = 4.0f;
    panel->minPaneSizeLogical = 30.0f;
    panel->colorHandle = Color { red: 60, green: 60, blue: 60, alpha: 255 };
    panel->colorHandleHovered = Color { red: 90, green: 90, blue: 90, alpha: 255 };
    panel->colorHandleDragged = Color { red: 120, green: 120, blue: 120, alpha: 255 };
    left: Box*! = MakeBox("left pane", LayoutMode:::None);
    left->style.margin = Insets:::All(2.0f);
    panel->SetFirst(left!);
    right: SplitPanel*! = new SplitPanel();
    right->className = "right split";
    right->axis = SplitAxis:::Vertical;
    right->splitRatio = 0.25f;
    right->handleThicknessLogical = 2.0f;
    top: Box*! = MakeBox("top pane", LayoutMode:::None);
    right->SetFirst(top!);
    bottom: Box*! = MakeBox("bottom pane", LayoutMode:::None);
    right->SetSecond(bottom!);
    panel->SetSecond(right!);

    panel->Measure(Point { x: 200.0f, y: 100.0f });
    panel->Arrange(Rect { x: 0.0f, y: 0.0f, width: 200.0f, height: 100.0f }, layout);
    PrintTree(panel, 0);

    SplitFrame(panel, stacking, layout, "hover the handle", 100.0f, false, false, false);
    SplitFrame(panel, stacking, layout, "press the handle", 100.0f, true, true, false);
    SplitFrame(panel, stacking, layout, "drag right", 150.0f, false, true, false);
    SplitFrame(panel, stacking, layout, "drag past the minimum pane", 195.0f, false, true, false);
    SplitFrame(panel, stacking, layout, "release", 195.0f, false, false, true);
    PrintTree(panel, 0);

    renderer: RecordingRenderer*! = new RecordingRenderer();
    defer delete renderer;
    panel->Draw(renderer, stacking);
}

main :: () -> i32 {
    font: FixedAdvanceFont*! = new FixedAdvanceFont();
    defer delete font;
    window: Box*! = BuildWindow(font);
    defer delete window;

    viewport: Point = Point { x: 640.0f, y: 360.0f };
    desired: Point = window->Measure(viewport);
    print(desired.x);
    print(desired.y);
    layout: LayoutContext*! = new LayoutContext();
    defer delete layout;
    layout->viewportLogical = viewport;
    window->Arrange(Rect { x: 0.0f, y: 0.0f, width: viewport.x, height: viewport.y }, layout);
    PrintTree(window, 0);

    renderer: RecordingRenderer*! = new RecordingRenderer();
    defer delete renderer;
    stacking: StackingTracker*! = new StackingTracker();
    defer delete stacking;
    window->Draw(renderer, stacking);
    print(renderer->commandCount);

    SimulateInput();
    ShowPositioning();
    ShowStacking();
    ShowButtons();
    ShowScrolling();
    ShowTextInput(font);
    ShowKeyDispatch(font);
    ShowSplitPanel();
    return 0;
}
