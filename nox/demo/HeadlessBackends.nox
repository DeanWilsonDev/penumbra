Point :: import Point;
Rect :: import Rect;
Color :: import Color;
IRenderer :: import IRenderer;
IFontBackend :: import IFontBackend;
IClipboard :: import IClipboard;
IIconBackend :: import IIconBackend;

FixedAdvanceFont :: class {
    implements:
        IFontBackend;
public:
    advancePerSize~ f32 = 0.5f;

    MeasureText :: (text: string, sizeLogical: f32) -> Point {
        return Point { x: f32(text.length()) * sizeLogical * this->advancePerSize, y: sizeLogical };
    }
}

RecordingRenderer :: class {
    implements:
        IRenderer;
public:
    commandCount~ i32 = 0;
    printsDetail~ bool = true;

    FillRect~: (rect: Rect, color: Color) -> void {
        this->commandCount = this->commandCount + 1;
        print("fill");
        if !this->printsDetail {
            print(color.red);
            return;
        }
        this->PrintRect(rect);
        this->PrintColor(color);
    }

    StrokeRect~: (rect: Rect, color: Color, thicknessLogical: f32) -> void {
        this->commandCount = this->commandCount + 1;
        print("stroke");
        this->PrintRect(rect);
        this->PrintColor(color);
        print(thicknessLogical);
    }

    DrawLine~: (from: Point, to: Point, color: Color, thicknessLogical: f32) -> void {
        this->commandCount = this->commandCount + 1;
        print("line");
        print(from.x);
        print(from.y);
        print(to.x);
        print(to.y);
        print(thicknessLogical);
    }

    DrawText~: (text: string, origin: Point, sizeLogical: f32, color: Color) -> void {
        this->commandCount = this->commandCount + 1;
        print("text");
        print(text);
        print(origin.x);
        print(origin.y);
        print(sizeLogical);
    }

    PushClipRect~: (rect: Rect) -> void {
        this->commandCount = this->commandCount + 1;
        print("clip");
        this->PrintRect(rect);
    }

    PushClipRectUnbounded~: (rect: Rect?) -> void {
        this->commandCount = this->commandCount + 1;
        print("clip unbounded");
        if area := rect {
            this->PrintRect(area);
        }
        else {
            print("none");
        }
    }

    PopClipRect~: () -> void {
        this->commandCount = this->commandCount + 1;
        print("unclip");
    }

private:
    PrintRect :: (rect: Rect) -> void {
        print(rect.x);
        print(rect.y);
        print(rect.width);
        print(rect.height);
    }

    PrintColor :: (color: Color) -> void {
        print(color.red);
        print(color.green);
        print(color.blue);
        print(color.alpha);
    }
}

RecordingClipboard :: class {
    implements:
        IClipboard;
public:
    contents~ string! = "";

    !RecordingClipboard~: () {
        delete this->contents;
    }

    SetClipboardText~: (text: string) -> void {
        print("clipboard set");
        print(text);
        copied: string! = text.copy();
        delete this->contents;
        this->contents = copied!;
    }

    GetClipboardText :: () -> string! {
        print("clipboard get");
        return this->contents.copy();
    }
}

RecordingIconBackend :: class {
    implements:
        IIconBackend;
public:
    DrawIcon~: (renderer: IRenderer~*, iconName: string, boundsLogical: Rect, iconColor: Color) -> void {
        print("icon");
        print(iconName);
        print(boundsLogical.x);
        print(boundsLogical.y);
        print(boundsLogical.width);
        print(iconColor.red);
    }
}
